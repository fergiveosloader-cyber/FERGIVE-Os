{
  "version": 2,
  "functions": {
    "api/index.js": {
      "memory": 128,
      "maxDuration": 10
    }
  },
  "routes": [
    {
      "src": "/api/(.*)",
      "dest": "/api/index.js"
    },
    {
      "src": "/",
      "dest": "/index.html"
    },
    {
      "src": "/index.html",
      "dest": "/index.html"
    },
    {
      "src": "/reseller.html",
      "dest": "/reseller.html"
    },
    {
      "src": "/([a-zA-Z0-9_-]+)/login",
      "dest": "/reseller.html"
    },
    {
      "src": "/([a-zA-Z0-9_-]+)",
      "dest": "/reseller.html"
    }
  ]
}
