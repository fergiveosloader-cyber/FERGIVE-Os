{
  "version": 2,
  "builds": [
    {
      "src": "api/index.js",
      "use": "@vercel/node"
    },
    {
      "src": "index.html",
      "use": "@vercel/static"
    },
    {
      "src": "reseller.html",
      "use": "@vercel/static"
    }
  ],
  "routes": [
    {
      "src": "/api(.*)",
      "dest": "api/index.js"
    },
    {
      "src": "/:slug/login",
      "dest": "/reseller.html"
    },
    {
      "src": "/:slug",
      "dest": "/reseller.html"
    },
    {
      "src": "/",
      "dest": "/index.html"
    }
  ]
}
